# Django / DRF origin (no `/api`). Vite dev proxy forwards `/api` → here.
VITE_DJANGO_ORIGIN=https://api.etihadamu.com

# `npm run dev` uses `/api` automatically (same-origin). Force direct API in dev (needs CORS on server):
# VITE_API_BASE_URL=https://api.etihadamu.com/api

# Local backend example:
# VITE_DJANGO_ORIGIN=http://127.0.0.1:8000

# Public SPA (canonical / OG)
# VITE_SITE_URL=https://etihadamu.com
